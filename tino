"app.js": r'''const fields = [
  ["ipa", "ipaName"],
  ["p12", "p12Name"],
  ["profile", "profileName"]
];
const message = document.getElementById("message");
const button = document.getElementById("signBtn");

function update() {
  let ready = true;
  for (const [inputId, labelId] of fields) {
    const input = document.getElementById(inputId);
    const label = document.getElementById(labelId);
    if (input.files.length) {
      label.textContent = input.files[0].name;
    } else {
      ready = false;
    }
  }
  button.disabled = !ready;
  message.textContent = ready
    ? "ឯកសារទាំងបីត្រូវបានជ្រើសរើស។ Signing Engine មិនទាន់បានភ្ជាប់ទេ។"
    : "សូមជ្រើសរើស IPA, .p12 និង .mobileprovision។";
}
fields.forEach(([id]) => document.getElementById(id).addEventListener("change", update));
button.addEventListener("click", () => {
  message.textContent = "នេះជាគំរូ Interface ប៉ុណ្ណោះ។ មិនមានការចុះហត្ថលេខា ឬបង្កើត IPA ថ្មីទេ។ ត្រូវភ្ជាប់ Signing Engine ដែលមានសុវត្ថិភាពជាមុន។";
});
if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => navigator.serviceWorker.register("./sw.js").catch(() => {}));
}
''',
